{
	"name": "@deckomd/cli",
	"version": "0.1.0",
	"type": "module",
	"description": "Generate presentation slide decks from Markdown using Svelte.",
	"keywords": [
		"markdown",
		"slides",
		"presentation",
		"cli",
		"svelte"
	],
	"author": "kongsakchai",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kongsakchai/decko.git",
		"directory": "packages/cli"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"prepublishOnly": "bun run build",
	"bin": {
		"decko": "dist/index.mjs"
	},
	"scripts": {
		"dev": "tsx ./src/index.ts",
		"build": "tsdown"
	},
	"dependencies": {
		"@deckomd/decko": "^0.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"commander": "^15.0.0",
		"svelte": "^5.55.3",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"vite": "^8.0.8"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite-plugin-singlefile": "^2.3.4"
	}
}
