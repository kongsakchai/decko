{
	"name": "@deckomd/cli",
	"version": "0.1.2",
	"type": "module",
	"description": "The CLI for Decko - build slide decks from Markdown, with Svelte when you need it.",
	"keywords": [
		"decko",
		"markdown",
		"slides",
		"presentation",
		"cli",
		"svelte"
	],
	"author": "kongsakchai",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kongsakchai/decko.git",
		"directory": "packages/cli"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"bin": {
		"decko": "dist/index.mjs"
	},
	"scripts": {
		"dev": "tsx ./src/index.ts",
		"build": "tsdown",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@deckomd/decko": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"commander": "^15.0.0",
		"svelte": "^5.57.3",
		"tailwindcss": "^4.3.4",
		"tw-animate-css": "^1.4.0",
		"vite": "^8.3.6",
		"vite-plugin-singlefile": "^2.3.4"
	},
	"devDependencies": {
		"@types/node": "^25.9.9",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	}
}
