{
	"name": "@deckomd/parser",
	"version": "0.1.3",
	"type": "module",
	"description": "Markdown slide decks parser for Decko.",
	"keywords": [
		"markdown",
		"slides",
		"presentation",
		"remark",
		"parser"
	],
	"author": "kongsakchai",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kongsakchai/decko.git",
		"directory": "packages/parser"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "bun run build",
		"test": "bun run test:unit -- --run",
		"test:unit": "vitest",
		"test:cover": "vitest --coverage"
	},
	"dependencies": {
		"hast-util-to-html": "^9.0.6",
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-to-hast": "^13.2.1",
		"micromark-util-character": "^2.1.1",
		"micromark-util-classify-character": "^2.0.1",
		"micromark-util-html-tag-name": "^2.0.1",
		"micromark-util-resolve-all": "^2.0.1",
		"micromark-util-symbol": "^2.0.1",
		"micromark-util-types": "^2.0.3",
		"rehype-stringify": "^10.0.1",
		"remark-gemoji": "^8.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0",
		"unist-util-visit-parents": "^6.1.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/unist": "^3.0.3",
		"devlop": "^1.1.0"
	}
}
