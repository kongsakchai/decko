{
	"name": "@deckomd/decko",
	"version": "0.1.3",
	"description": "A Svelte preprocessor and component library for Decko.",
	"author": "kongsakchai",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"markdown",
		"slides",
		"presentation",
		"svelte",
		"preprocessor"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kongsakchai/decko.git",
		"directory": "packages/decko"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./builtin": {
			"types": "./dist/builtin/index.d.ts",
			"svelte": "./dist/builtin/index.js",
			"import": "./dist/builtin/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"svelte": "./dist/components/index.js",
			"import": "./dist/components/index.js"
		},
		"./pages": {
			"types": "./dist/pages/index.d.ts",
			"svelte": "./dist/pages/index.js",
			"import": "./dist/pages/index.js"
		},
		"./context": {
			"types": "./dist/context/index.d.ts",
			"import": "./dist/context/index.js"
		},
		"./state": {
			"types": "./dist/state/index.d.ts",
			"import": "./dist/state/index.js"
		},
		"./client/*": {
			"types": "./dist/client/*.d.ts",
			"import": "./dist/client/*.js"
		},
		"./logic/*": {
			"style": "./dist/logic/*",
			"import": "./dist/logic/*"
		},
		"./styles/*": {
			"style": "./dist/styles/*",
			"import": "./dist/styles/*"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/js-yaml": "^4.0.9",
		"@types/mdast": "^4.0.4",
		"globals": "^17.6.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@deckomd/parser": "workspace:*",
		"@shikijs/magic-move": "^4.3.1",
		"@shikijs/transformers": "^4.3.1",
		"lz-string": "^1.5.0",
		"magic-string": "^1.1.0",
		"mermaid": "^11.16.0",
		"shiki": "^4.3.1"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
