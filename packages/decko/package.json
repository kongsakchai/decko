{
	"name": "@deckomd/decko",
	"version": "0.1.2",
	"type": "module",
	"description": "A Svelte preprocessor and component library for Decko.",
	"keywords": [
		"markdown",
		"slides",
		"presentation",
		"svelte",
		"preprocessor"
	],
	"author": "kongsakchai",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kongsakchai/decko.git",
		"directory": "packages/decko"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"prepack": "svelte-package && publint",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./builtin": {
			"types": "./dist/builtin/index.d.ts",
			"svelte": "./dist/builtin/index.js",
			"import": "./dist/builtin/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"svelte": "./dist/components/index.js",
			"import": "./dist/components/index.js"
		},
		"./pages": {
			"types": "./dist/pages/index.d.ts",
			"svelte": "./dist/pages/index.js",
			"import": "./dist/pages/index.js"
		},
		"./context": {
			"types": "./dist/context/index.d.ts",
			"import": "./dist/context/index.js"
		},
		"./state": {
			"types": "./dist/state/index.d.ts",
			"import": "./dist/state/index.js"
		},
		"./client/*": {
			"types": "./dist/client/*.d.ts",
			"import": "./dist/client/*.js"
		},
		"./logic/*": {
			"style": "./dist/logic/*",
			"import": "./dist/logic/*"
		},
		"./styles/*": {
			"style": "./dist/styles/*",
			"import": "./dist/styles/*"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"devDependencies": {
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@tsconfig/svelte": "^5.0.8",
		"@types/js-yaml": "^4.0.9",
		"@types/mdast": "^4.0.4",
		"publint": "^0.3.25",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"tw-animate-css": "^1.4.0",
		"vite": "^8.3.6"
	},
	"peerDependencies": {
		"svelte": "^5.57.3"
	}
}
