{
	"name": "decko",
	"version": "0.1.2",
	"type": "module",
	"main": "index.js",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"cli": "bun run --cwd packages/cli dev",
		"cli:full": "bun run build:parser && bun run prepack:decko && bun run --cwd packages/cli dev",
		"cli:preview": "bunx live-server ./packages/cli/dist",
		"dev": "bun run --cwd packages/decko dev",
		"build": "bun run build:parser && bun run prepack:decko && bun run build:cli",
		"build:parser": "bun run --cwd packages/parser build",
		"build:decko": "bun run --cwd packages/decko build",
		"build:cli": "bun run --cwd packages/cli build",
		"prepack:decko": "bun run --cwd packages/decko prepack",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "bun run test:parser && bun run test:decko",
		"test:parser": "bun run --cwd packages/parser test",
		"test:unit:parser": "bun run --cwd packages/parser test:unit",
		"test:cover:parser": "bun run --cwd packages/parser test:cover",
		"test:decko": "bun run --cwd packages/decko test"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"description": "",
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/package": "^2.5.8",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^25.9.9",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"tsdown": "^0.21.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^4.1.12"
	}
}
